generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatRole {
  user
  assistant
}

model User {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  email         String         @unique
  firstName     String?
  lastName      String?
  avatarUrl     String?
  apiKey        String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  actionItems   ActionItem[]
  conversations Conversation[]
  decisions     Decision[]
  questions     Question[]
  workspaces    Workspace[]
  chatMessages  ChatMessage[]
  aiSettings    UserAiSettings?
}

// Bring-your-own-model settings. The API key is stored encrypted (AES-256-GCM); null = use the server default.
model UserAiSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  provider     String
  model        String
  baseUrl      String?
  encryptedKey String?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  actionItems   ActionItem[]
  conversations Conversation[]
  decisions     Decision[]
  questions     Question[]
  chatMessages  ChatMessage[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String       @id @default(cuid())
  title       String
  content     String
  // When the chat actually happened (from the source). null = unknown, fall back to createdAt.
  occurredAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspaceId String
  userId      String
  actionItems ActionItem[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decisions   Decision[]
  questions   Question[]
  images      ConversationImage[]
}

// Images captured with a conversation (e.g. screenshots in a shared Gemini chat).
// Stored in the database so they stay private and don't break when the source link expires.
model ConversationImage {
  id             String       @id @default(cuid())
  mimeType       String
  data           Bytes
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Decision {
  id             String        @id @default(cuid())
  title          String
  summary        String
  status         String        @default("pending")
  confidence     Float         @default(0.5)
  source         String        @default("manual")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversationId String?
  workspaceId    String
  userId         String
  /// Semantic-search embedding (pgvector). Written/read via raw SQL only.
  embedding      Unsupported("vector(768)")?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id             String        @id @default(cuid())
  title          String
  status         String        @default("pending")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversationId String?
  workspaceId    String
  userId         String
  description    String        @default("")
  priority       String        @default("medium")
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Question {
  id             String        @id @default(cuid())
  question       String
  status         String        @default("open")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversationId String?
  workspaceId    String
  userId         String
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        ChatRole
  content     String    @db.Text
  sources     Json?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
