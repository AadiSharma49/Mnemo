# ──────────────────────────────────────────────────────────────────────────
# Mnemo — environment template.
# Copy this file to `.env` and fill in your own values.
# Your real `.env` is gitignored and must NEVER be committed.
# All values below are PLACEHOLDERS — replace them.
# ──────────────────────────────────────────────────────────────────────────

# ── Database: PostgreSQL (e.g. Neon) ──
# Must be a Postgres instance where the `pgvector` extension can be enabled
# (required for semantic search & conflict detection).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Authentication: Clerk ──
# From your Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

# ── AI provider: Google Gemini ──
# Powers extraction, embeddings, Memory Chat and conflict detection.
GEMINI_API_KEY="replace_me"

# ── Bring-your-own-model (Settings → AI Model) ──
# Users' API keys are stored encrypted with this secret. REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET="replace_me"
# Self-hosted only: allow users to point at private/localhost URLs (e.g. Ollama on the same server).
# Leave unset on a public deployment.
# ALLOW_PRIVATE_AI_URLS="true"

# Optional — server default model, used when a user hasn't connected their own
# in Settings → AI Model. The default is Google Gemini.
AI_MODEL="gemini-2.5-flash"

# ── Public URLs ──
# Used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
# Set these to your deployed URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
